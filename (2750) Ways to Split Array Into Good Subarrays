class Solution:
    def numberOfGoodSubarraySplits(self, nums: List[int]) -> int:
        num = 1
        plus = 0
        totalsum=sum(nums)
        if totalsum==len(nums):
            return 1
        if totalsum==0:
            return 0
        for i in range(len(nums)):
            if nums[i] == 1:
                break       
        for x in range(i, len(nums)):
            if nums[x] == 0:
                plus += 1
            if nums[x] == 1:
                plus += 1
                num *= plus
                plus = 0
        if num > (10**9 + 7):
            num = num%(10**9 + 7 )
        return num       




        
