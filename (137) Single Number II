class Solution:
    def singleNumber(self, nums: List[int]) -> int:
        while (len(nums)) > 1:
            for i in nums:
                nums.remove(i)
                if i in nums:
                    nums.remove(i)
                    nums.remove(i)
                else:
                    nums.append(i)
                  
        return nums[0]        
        
