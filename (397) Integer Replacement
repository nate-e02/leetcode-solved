class Solution:
    def integerReplacement(self, n: int) -> int:
        i = 0
        while n > 1 :
            if n% 2 == 0:
                n = n/2
                i += 1
            else:
                v = ((n-1)/2)
                if n == 3:
                    n = n - 1  
                    i += 1
                elif v % 2 == 0:
                    n = n - 1  
                    i += 1 

                else: 
                    n = n + 1  
                    i += 1 

        return i
